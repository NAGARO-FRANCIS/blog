/* ==========================================================
   ASSISTANT DE PUBLICATION EN 4 ÉTAPES
========================================================== */
.publish-progress {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-top: 28px;
}
.publish-progress-item {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
    padding: 10px 12px;
    border: 1px solid rgba(255,255,255,.24);
    border-radius: 13px;
    background: rgba(255,255,255,.10);
    color: rgba(255,255,255,.78);
    font-size: .82rem;
    font-weight: 650;
    transition: background .2s ease, border-color .2s ease;
}
.publish-progress-number {
    display: inline-grid;
    place-items: center;
    width: 29px;
    height: 29px;
    flex: 0 0 29px;
    border: 1px solid rgba(255,255,255,.45);
    border-radius: 50%;
    color: #fff;
    font-weight: 800;
}
.publish-progress-item.is-active,
.publish-progress-item.is-complete {
    border-color: rgba(255,255,255,.65);
    background: rgba(255,255,255,.20);
    color: #fff;
}
.publish-progress-item.is-active .publish-progress-number,
.publish-progress-item.is-complete .publish-progress-number {
    border-color: #fff;
    background: #fff;
    color: var(--publish-accent-dark);
}
.wizard-heading {
    margin-bottom: 22px;
}
.wizard-heading .wizard-kicker {
    display: inline-block;
    margin-bottom: 8px;
    color: var(--publish-accent-dark);
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
}
.wizard-heading h2 {
    margin: 0 0 7px;
    color: #182230;
    font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    font-weight: 850;
}
.wizard-heading p {
    margin: 0;
    color: #667085;
    line-height: 1.7;
}
.wizard-panel[hidden],
[data-wizard-review][hidden],
.professional-publish-page .row[hidden],
.room-media-section[hidden] {
    display: none !important;
}
.publish-actions {
    position: static;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px;
    margin-top: 20px;
    border: 1px solid #e3e8ef;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(16,24,40,.07);
}
.publish-actions .btn {
    min-width: 145px;
}
.publish-actions .wizard-spacer {
    flex: 1;
}
.wizard-review-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 20px 0 0;
}
.wizard-review-item {
    min-width: 0;
    padding: 15px;
    border: 1px solid #e6eaf0;
    border-radius: 12px;
    background: #f8fafc;
}
.wizard-review-item span {
    display: block;
    margin-bottom: 5px;
    color: #667085;
    font-size: .79rem;
    font-weight: 700;
}
.wizard-review-item strong {
    display: block;
    color: #182230;
    font-size: .95rem;
    overflow-wrap: anywhere;
}
.wizard-review-note {
    margin-top: 18px;
    padding: 14px 16px;
    border: 1px solid rgba(var(--publish-rgb), .22);
    border-radius: 12px;
    background: var(--publish-tint);
    color: #344054;
    font-size: .9rem;
    line-height: 1.7;
}
.wizard-validation-message {
    display: none;
    margin-bottom: 18px;
    padding: 12px 15px;
    border: 1px solid #fecaca;
    border-radius: 11px;
    background: #fef2f2;
    color: #991b1b;
    font-size: .88rem;
}
.wizard-validation-message.is-visible { display: block; }

@media (max-width: 767px) {
    .publish-progress {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        margin-top: 20px;
    }
    .publish-progress-item {
        padding: 8px 9px;
        border-radius: 10px;
        font-size: .76rem;
    }
    .publish-progress-number {
        width: 25px;
        height: 25px;
        flex-basis: 25px;
    }
    .publish-actions {
        position: static;
        flex-wrap: wrap;
        padding: 10px;
        gap: 9px;
    }
    .publish-actions .btn {
        flex: 1 1 100%;
        width: 100%;
        min-width: 0;
    }
    .publish-actions .wizard-spacer { display: none; }
    .wizard-review-list { grid-template-columns: 1fr; gap: 9px; }
}

</style>
{% endblock %}

{% block content %}
<div class="professional-publish-page {% if account_type == 'residence' %}residence{% else %}hotel{% endif %}" id="publication-wizard">
  <div class="row justify-content-center">
    <div class="col-12">
      <div class="professional-publish-header">
        <span class="publish-eyebrow">{% if account_type == 'hotel' %}🏨 {% translate "Espace hôtelier" %}{% else %}🏢 {% translate "Espace résidence" %}{% endif %}</span>
        <h1>{% translate "Publier mon établissement" %}</h1>
        <p class="mb-0">
          {% if account_type == 'hotel' %}
            {% translate "Présentez votre établissement, détaillez vos chambres et vérifiez votre annonce avant publication." %}
          {% else %}
            {% translate "Présentez votre résidence, détaillez vos logements et vérifiez votre annonce avant publication." %}
          {% endif %}
        </p>
        <div class="publish-progress" aria-label="Progression de la publication">
          <div class="publish-progress-item is-active" data-progress-step="1" aria-current="step"><span class="publish-progress-number">1</span><span>{% translate "Établissement" %}</span></div>
          <div class="publish-progress-item" data-progress-step="2"><span class="publish-progress-number">2</span><span>{% translate "Chambres" %}</span></div>
          <div class="publish-progress-item" data-progress-step="3"><span class="publish-progress-number">3</span><span>{% translate "Photos & vidéos" %}</span></div>
          <div class="publish-progress-item" data-progress-step="4"><span class="publish-progress-number">4</span><span>{% translate "Vérification" %}</span></div>
        </div>
      </div>

      <form method="post" enctype="multipart/form-data" id="establishment-publish-form" novalidate>
        {% csrf_token %}
        {{ type_formset.management_form }}

        {% if messages %}
          {% for message in messages %}
            <div class="alert alert-{{ message.tags|default:'info' }} mb-4">{{ message }}</div>
          {% endfor %}
        {% endif %}

        <div class="wizard-validation-message" id="wizard-validation-message" role="alert">{% translate "Veuillez vérifier les champs obligatoires avant de continuer." %}</div>

        <!-- ÉTAPE 1 : INFORMATIONS DE L'ÉTABLISSEMENT -->
        <section class="card shadow-sm mb-4 border-0 wizard-panel" data-wizard-panel="1">
          <div class="card-body p-4">
            <div class="wizard-heading">
              <span class="wizard-kicker">{% translate "Étape 1 sur 4" %}</span>
              <h2>📍 {% translate "Informations de l'établissement" %}</h2>
              <p>{% translate "Commencez par présenter votre établissement et sa localisation." %}</p>
            </div>
            <div class="row g-3">
              <div class="col-md-6">
                {{ etablissement_form.nom.label_tag }}
                {{ etablissement_form.nom }}
                {% if etablissement_form.nom.errors %}<div class="text-danger small mt-1">{{ etablissement_form.nom.errors }}</div>{% endif %}
              </div>
              <div class="col-md-6">
                {{ etablissement_form.ville.label_tag }}
                {{ etablissement_form.ville }}
                {% if etablissement_form.ville.errors %}<div class="text-danger small mt-1">{{ etablissement_form.ville.errors }}</div>{% endif %}
              </div>
              <div class="col-md-6">
                {{ etablissement_form.commune.label_tag }}
                {{ etablissement_form.commune }}
                {% if etablissement_form.commune.errors %}<div class="text-danger small mt-1">{{ etablissement_form.commune.errors }}</div>{% endif %}
              </div>
              <div class="col-md-6">
                {{ etablissement_form.quartier.label_tag }}
                {{ etablissement_form.quartier }}
                {% if etablissement_form.quartier.errors %}<div class="text-danger small mt-1">{{ etablissement_form.quartier.errors }}</div>{% endif %}
              </div>
              <div class="col-12">
                {{ etablissement_form.description.label_tag }}
                {{ etablissement_form.description }}
                {% if etablissement_form.description.errors %}<div class="text-danger small mt-1">{{ etablissement_form.description.errors }}</div>{% endif %}
              </div>
              <div class="col-md-6">
                <div class="form-check mt-2">
                  {{ etablissement_form.eau }}
                  <label class="form-check-label ms-2" for="{{ etablissement_form.eau.id_for_label }}">{{ etablissement_form.eau.label }}</label>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-check mt-2">
                  {{ etablissement_form.electricite }}
                  <label class="form-check-label ms-2" for="{{ etablissement_form.electricite.id_for_label }}">{{ etablissement_form.electricite.label }}</label>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ÉTAPES 2 ET 3 : LES CARTES RESTENT DANS LE MÊME FORMULAIRE -->
        <section class="card shadow-sm mb-4 border-0 wizard-panel" data-wizard-panel="2-3" hidden>
          <div class="card-body p-4">
            <div class="wizard-heading" id="rooms-step-heading">
              <span class="wizard-kicker">{% translate "Étape 2 sur 4" %}</span>
              <h2>🛏️ {% translate "Types de chambres ou logements" %}</h2>
              <p>{% translate "Renseignez chaque catégorie proposée, son prix, sa capacité et ses équipements." %}</p>
            </div>
            <div class="wizard-heading" id="media-step-heading" hidden>
              <span class="wizard-kicker">{% translate "Étape 3 sur 4" %}</span>
              <h2>📸 {% translate "Photos et vidéos" %}</h2>
              <p>{% translate "Ajoutez des médias pour présenter chaque type de chambre ou de logement." %}</p>
            </div>

            <div id="room-forms">
              {% for room_form in type_formset %}
                {% include 'logement/partials/type_chambre_form.html' with room_form=room_form photo_formset=room_form.photo_formset video_formset=room_form.video_formset account_type=account_type room_number=forloop.counter %}
              {% endfor %}
            </div>

            <template id="empty-room-form">
              {% include 'logement/partials/type_chambre_form.html' with room_form=type_formset.empty_form photo_formset=empty_photo_formset video_formset=empty_video_formset account_type=account_type room_number='__prefix__' %}
            </template>
            <button type="button" class="btn btn-outline-primary add-room-button" id="add-room">
              <span aria-hidden="true">＋</span> {% translate "Ajouter un type de chambre" %}
            </button>
            <p class="text-muted small mt-2 mb-0" id="room-count" aria-live="polite"></p>
          </div>
        </section>

        <!-- ÉTAPE 4 : RÉCAPITULATIF -->
        <section class="card shadow-sm mb-4 border-0 wizard-panel" data-wizard-panel="4" hidden>
          <div class="card-body p-4">
            <div class="wizard-heading">
              <span class="wizard-kicker">{% translate "Étape 4 sur 4" %}</span>
              <h2>✅ {% translate "Vérifiez votre annonce" %}</h2>
              <p>{% translate "Relisez ces informations avant de publier. Vous pouvez revenir aux étapes précédentes pour corriger un détail." %}</p>
            </div>
            <div class="wizard-review-list">
              <div class="wizard-review-item"><span>{% translate "Nom de l'établissement" %}</span><strong data-review="nom">—</strong></div>
              <div class="wizard-review-item"><span>{% translate "Ville" %}</span><strong data-review="ville">—</strong></div>
              <div class="wizard-review-item"><span>{% translate "Commune" %}</span><strong data-review="commune">—</strong></div>
              <div class="wizard-review-item"><span>{% translate "Quartier" %}</span><strong data-review="quartier">—</strong></div>
              <div class="wizard-review-item"><span>{% translate "Types renseignés" %}</span><strong data-review="rooms">0</strong></div>
              <div class="wizard-review-item"><span>{% translate "Photos sélectionnées" %}</span><strong data-review="photos">0</strong></div>
              <div class="wizard-review-item"><span>{% translate "Vidéos sélectionnées" %}</span><strong data-review="videos">0</strong></div>
            </div>
            <div class="wizard-review-note">{% translate "La publication sera enregistrée après validation par le serveur. Assurez-vous que les informations et les médias sont corrects." %}</div>
          </div>
        </section>

        <div class="publish-actions" id="publish-wizard-actions">
          <a href="{% url 'logement:home' %}" class="btn btn-secondary" id="cancel-publish">{% translate "Annuler" %}</a>
          <button type="button" class="btn btn-secondary" id="wizard-back" hidden>← {% translate "Retour" %}</button>
          <span class="wizard-spacer"></span>
          <button type="button" class="btn btn-primary" id="wizard-next">{% translate "Continuer" %} →</button>
          <button type="submit" class="btn btn-primary" id="wizard-submit" hidden>{% translate "Publier l'établissement" %} ✓</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const root = document.getElementById('publication-wizard');
  const form = document.getElementById('establishment-publish-form');
  const container = document.getElementById('room-forms');
  const addButton = document.getElementById('add-room');
  const template = document.getElementById('empty-room-form');
  const totalForms = document.getElementById('id_types-TOTAL_FORMS');
  const countLabel = document.getElementById('room-count');
  const nextButton = document.getElementById('wizard-next');
  const backButton = document.getElementById('wizard-back');
  const submitButton = document.getElementById('wizard-submit');
  const cancelButton = document.getElementById('cancel-publish');
  const validationMessage = document.getElementById('wizard-validation-message');
  const roomsHeading = document.getElementById('rooms-step-heading');
  const mediaHeading = document.getElementById('media-step-heading');
  const reviewPanel = document.querySelector('[data-wizard-panel="4"]');
  let currentStep = 1;

  if (!root || !form || !container || !addButton || !template || !totalForms) return;

  function roomCards() {
    return Array.from(container.querySelectorAll('.room-card')).filter(card => {
      const del = card.querySelector('input[name$="-DELETE"]');
      return !(del && del.checked);
    });
  }

  function updateRoomCount() {
    const cards = roomCards();
    const completed = cards.filter(card => {
      const title = card.querySelector('input[name$="-titre"]');
      return title && title.value.trim();
    }).length;
    const label = completed === 1
      ? '{% translate "type de chambre renseigné" %}'
      : '{% translate "types de chambre renseignés" %}';
    if (countLabel) countLabel.textContent = `${completed} ${label}`;
  }

  function bindRemoveButton(card) {
    const removeButton = card.querySelector('[data-remove-room]');
    if (!removeButton || removeButton.dataset.bound === '1') return;
    removeButton.dataset.bound = '1';
    removeButton.addEventListener('click', function () {
      const deleteInput = card.querySelector('input[name$="-DELETE"]');
      if (deleteInput) deleteInput.checked = true;
      card.hidden = true;
      updateRoomCount();
      updateReview();
    });
  }

  function toggleRoomFieldsForStep(step) {
    roomCards().forEach(card => {
      const fields = card.querySelector('.row');
      const mediaSections = card.querySelectorAll('.room-media-section');
      const removeButton = card.querySelector('[data-remove-room]');
      if (fields) fields.hidden = (step === 3);
      mediaSections.forEach(section => { section.hidden = (step !== 3); });
      if (removeButton) removeButton.hidden = (step === 3);
      card.hidden = false;
    });
    if (addButton) addButton.hidden = (step !== 2);
    if (countLabel) countLabel.hidden = (step !== 2);
    if (roomsHeading) roomsHeading.hidden = (step !== 2);
    if (mediaHeading) mediaHeading.hidden = (step !== 3);
  }

  function valueOf(name) {
    const field = form.querySelector(`[name="${name}"]`);
    if (!field) return '—';
    const value = (field.value || '').trim();
    return value || '—';
  }

  function updateReview() {
    const setReview = (key, value) => {
      const node = root.querySelector(`[data-review="${key}"]`);
      if (node) node.textContent = value;
    };
    setReview('nom', valueOf('nom'));
    setReview('ville', valueOf('ville'));
    setReview('commune', valueOf('commune'));
    setReview('quartier', valueOf('quartier'));
    setReview('rooms', String(roomCards().filter(card => {
      const title = card.querySelector('input[name$="-titre"]');
      return title && title.value.trim();
    }).length));
    setReview('photos', String(Array.from(form.querySelectorAll('input[type="file"][name$="-image"]')).filter(input => input.files && input.files.length).length));
    setReview('videos', String(Array.from(form.querySelectorAll('input[type="file"][name$="-video"]')).filter(input => input.files && input.files.length).length));
  }

  function showStep(step, shouldScroll = true) {
    currentStep = Math.max(1, Math.min(4, step));
    root.querySelectorAll('[data-wizard-panel]').forEach(panel => {
      const key = panel.getAttribute('data-wizard-panel');
      if (key === '2-3') panel.hidden = !(currentStep === 2 || currentStep === 3);
      else panel.hidden = Number(key) !== currentStep;
    });
    toggleRoomFieldsForStep(currentStep);

    root.querySelectorAll('[data-progress-step]').forEach(item => {
      const n = Number(item.getAttribute('data-progress-step'));
      item.classList.toggle('is-active', n === currentStep);
      item.classList.toggle('is-complete', n < currentStep);
      if (n === currentStep) item.setAttribute('aria-current', 'step');
      else item.removeAttribute('aria-current');
      const number = item.querySelector('.publish-progress-number');
      if (number) number.textContent = n < currentStep ? '✓' : String(n);
    });

    backButton.hidden = currentStep === 1;
    nextButton.hidden = currentStep === 4;
    submitButton.hidden = currentStep !== 4;
    cancelButton.hidden = currentStep !== 1;
    if (currentStep === 4) updateReview();
    if (validationMessage) validationMessage.classList.remove('is-visible');
    if (shouldScroll) root.scrollIntoView({behavior: 'smooth', block: 'start'});
  }

  function stepHasErrors(step) {
    const panel = root.querySelector(`[data-wizard-panel="${step}"]`);
    if (panel && panel.querySelector('.text-danger, .errorlist, .is-invalid')) return true;
    if (step === 2 || step === 3) {
      const shared = root.querySelector('[data-wizard-panel="2-3"]');
      if (!shared) return false;
      const errors = Array.from(shared.querySelectorAll('.text-danger, .errorlist, .is-invalid'));
      return errors.some(error => {
        const media = error.closest('.room-media-section');
        return step === 3 ? Boolean(media) : !media;
      });
    }
    return false;
  }

  function validateVisibleStep() {
    const active = currentStep === 1
      ? root.querySelector('[data-wizard-panel="1"]')
      : root.querySelector('[data-wizard-panel="2-3"]');
    if (currentStep === 4 || !active) return true;
    const fields = Array.from(active.querySelectorAll('input, select, textarea')).filter(field => {
      if (field.type === 'hidden' || field.disabled) return false;
      if (field.name && field.name.endsWith('-DELETE')) return false;
      if (field.closest('[hidden]')) return false;
      if (currentStep === 2 && field.closest('.room-media-section')) return false;
      if (currentStep === 3 && !field.closest('.room-media-section') && !field.name.includes('TOTAL_FORMS') && !field.name.includes('INITIAL_FORMS') && !field.name.includes('MIN_NUM_FORMS') && !field.name.includes('MAX_NUM_FORMS')) return false;
      return true;
    });
    for (const field of fields) {
      if (typeof field.checkValidity === 'function' && !field.checkValidity()) {
        field.reportValidity();
        return false;
      }
    }
    return true;
  }

  function goNext() {
    if (!validateVisibleStep()) {
      if (validationMessage) validationMessage.classList.add('is-visible');
      return;
    }
    if (currentStep === 2 && roomCards().filter(card => {
      const title = card.querySelector('input[name$="-titre"]');
      return title && title.value.trim();
    }).length === 0) {
      if (validationMessage) {
        validationMessage.textContent = '{% translate "Ajoutez au moins un type de chambre et renseignez son titre avant de continuer." %}';
        validationMessage.classList.add('is-visible');
      }
      return;
    }
    showStep(currentStep + 1);
  }

  container.querySelectorAll('.room-card').forEach(card => {
    bindRemoveButton(card);
    const deleteInput = card.querySelector('input[name$="-DELETE"]');
    if (deleteInput && deleteInput.checked) card.hidden = true;
  });
  container.addEventListener('input', function () { updateRoomCount(); updateReview(); });
  container.addEventListener('change', updateReview);
  form.addEventListener('change', updateReview);

  addButton.addEventListener('click', function () {
    const formIndex = Number.parseInt(totalForms.value, 10);
    const markup = template.innerHTML.split('__prefix__').join(String(formIndex));
    const wrapper = document.createElement('div');
    wrapper.innerHTML = markup.trim();
    const card = wrapper.firstElementChild;
    if (!card) return;
    const number = card.querySelector('[data-room-number]');
    if (number) number.textContent = String(formIndex + 1);
    container.appendChild(card);
    totalForms.value = String(formIndex + 1);
    bindRemoveButton(card);
    const titleField = card.querySelector(`[name="types-${formIndex}-titre"]`);
    if (titleField) titleField.focus();
    toggleRoomFieldsForStep(currentStep);
    updateRoomCount();
    updateReview();
  });

  nextButton.addEventListener('click', goNext);
  backButton.addEventListener('click', function () { showStep(currentStep - 1); });

  // Après une réponse invalide du serveur, afficher l'étape qui contient les erreurs.
  let initialStep = 1;
  if (stepHasErrors(3)) initialStep = 3;
  else if (stepHasErrors(2)) initialStep = 2;
  else if (stepHasErrors(1)) initialStep = 1;
  updateRoomCount();
  updateReview();
  showStep(initialStep, false);
});
</script>
{% endblock %}